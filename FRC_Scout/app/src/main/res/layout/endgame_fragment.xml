<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/scouting_scroll_bottom_nav__margin">

        <!-- start endgame fragment main layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section: DIED -->
            <!-- start DIED card layout -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin"
                android:layout_marginHorizontal="@dimen/card_margin"
                app:cardBackgroundColor="#b2538e"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/section_padding">

                    <TextView
                        android:id="@+id/endgame_died_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/died"
                        android:textColor="@color/customTextPrimary"
                        android:textSize="@dimen/font_medium"
                        android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="570dp"
                    android:layout_marginTop="7dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_rect"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginStart="3dp"
                    >

                    <!-- start DIED RADIO BUTTONS layout -->
                    <LinearLayout
                        android:id="@+id/endgame_died_radio_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:orientation="horizontal">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="N/A"
                            android:layout_marginStart="5dp"
                            android:paddingLeft="3dp"
                            android:textColor="@color/customTextPrimary"
                            android:textSize="20sp"

                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15-30s"
                            android:layout_marginStart="70dp"
                            android:textColor="@color/customTextPrimary"
                            android:textSize="21sp"

                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30-60s"
                            android:layout_marginStart="70dp"
                            android:textColor="@color/customTextPrimary"
                            android:textSize="21sp"

                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="60-90s"
                            android:layout_marginStart="70dp"
                            android:textColor="@color/customTextPrimary"
                            android:textSize="21sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Most"
                            android:layout_marginStart="57dp"
                            android:textColor="@color/customTextPrimary"
                            android:textSize="21sp" />


                    </LinearLayout>


                    <!-- end TEXT FOR DIED TIME SLIDER layout -->

                    <!-- start HOPPER ACCURACY SLIDER layout -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >

                        <com.google.android.material.slider.Slider
                            android:id="@+id/teleop_hopper_accuracy_slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="1dp"
                            android:stepSize="1"
                            android:value="0.0"
                            android:valueFrom="0.0"
                            android:valueTo="4.0"
                            app:trackColorActive="@color/customTextPrimary"
                            app:trackColorInactive="@color/customTextPrimary"
                            app:thumbColor="#6E79D5"
                            app:tickColorActive="#c64e34"
                            app:labelBehavior="gone" />

                    </LinearLayout>
                    </LinearLayout>
                        android:layout_width=""
                        android:layout_height=""
                    <!-- end HOPPER ACCURACY SLIDER layout -->

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
            <!-- end DIED card layout -->
            <!-- start NO SHOW card layout -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/no_show"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin"
                android:layout_marginHorizontal="@dimen/card_margin"
                app:cardBackgroundColor="#93A685"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- start NO SHOW CHIP layout -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/section_padding">

                        <TextView
                            android:id="@+id/no_show_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="NO SHOW"
                            android:textColor="@color/customTextPrimary"
                            android:textSize="@dimen/font_medium"
                            android:textStyle="bold" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/no_show_chip"
                            style="@style/CustomChipStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:text="No Show" />
                    </LinearLayout>

                    <!-- end NO SHOW layout -->
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- end NO SHOW card layout -->

            <!-- Section: COMMENTS -->
            <!-- start COMMENTS layout -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/endgame_comments_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin"
                android:layout_marginHorizontal="@dimen/card_margin"
                app:counterEnabled="true"
                app:counterMaxLength="200">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/endgame_comments_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/comments"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:minLines="1"
                    android:textColor="@color/textPrimary" />
            </com.google.android.material.textfield.TextInputLayout>
            <!-- end COMMENTS layout -->

            <!-- start QR Code button layout -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/endgame_generate_qr_button"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/colorPrimary"
                    app:icon="@drawable/qr_code_icon"
                    app:iconSize="120dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:padding="0dp"
                    android:focusable="true"
                    android:contentDescription="@string/qr_code_image" />

            </RelativeLayout>
            <!-- end QR Code button layout -->

        </LinearLayout>
        <!-- end endgame fragment layout -->

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
