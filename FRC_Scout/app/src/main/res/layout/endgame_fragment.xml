<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/scouting_scroll_bottom_nav__margin">

        <!-- start Endgame fragment main layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section: DRIVER ABILITY -->
            <!-- start DRIVER ABILITY card layout -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/card_margin"
                android:layout_marginTop="@dimen/card_margin"
                app:cardBackgroundColor="#9aa3f2"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <!-- start DRIVING ABILITY layout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="15dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:layout_marginStart="9dp"
                        android:text="@string/driving_ability"
                        android:textColor="@color/customTextPrimary"
                        android:textSize="@dimen/font_medium"
                        android:textStyle="bold" />

                    <!-- start DRIVING ABILITY SLIDER section layout -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_marginTop="7dp"
                        android:layout_marginEnd="9dp"
                        android:background="@drawable/rounded_rect"
                        android:backgroundTint="#DBDEF8"
                        android:orientation="vertical">

                        <!-- start DRIVING ABILITY text labels layout -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="N/A"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="63.5dp"
                                android:text="Slow"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="68.5dp"
                                android:text="Jerky"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="69.5dp"
                                android:text="Avg"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="75dp"
                                android:text="Fast"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="57dp"
                                android:text="Elite"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp" />

                        </LinearLayout>
                        <!-- end DRIVING ABILITY text labels layout -->

                        <!-- start DRIVING ABILITY SLIDER layout -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.slider.Slider
                                android:id="@+id/endgame_driving_ability_slider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:stepSize="1.0"
                                android:value="0.0"
                                android:valueFrom="0.0"
                                android:valueTo="5.0"
                                app:labelBehavior="gone"
                                app:thumbColor="#6E79D5"
                                app:tickColorActive="#c64e34"
                                app:trackColorActive="@color/customTextPrimary"
                                app:trackColorInactive="@color/customTextPrimary" />
                        </LinearLayout>
                        <!-- end DRIVING ABILITY SLIDER layout -->
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- end DRIVER ABILITY card layout -->

            <!-- Section: DIED -->
            <!-- start DIED card layout -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/card_margin"
                android:layout_marginTop="@dimen/card_margin"
                app:cardBackgroundColor="#B786EF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:layout_marginStart="9dp"
                        android:text="@string/died"
                        android:textColor="@color/customTextPrimary"
                        android:textSize="@dimen/font_medium"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_marginTop="7dp"
                        android:layout_marginEnd="9dp"
                        android:layout_marginBottom="15dp"
                        android:background="@drawable/rounded_rect"
                        android:backgroundTint="#E9E0F8"
                        android:orientation="vertical">

                        <!-- start DIED layout -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="N/A"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="84dp"
                                android:text="15-30s"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="81dp"
                                android:text="30-60s"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="77dp"
                                android:text="60-90s"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="57dp"
                                android:text="Most"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp" />

                        </LinearLayout>
                        <!-- end TEXT FOR DIED SLIDER text labels layout -->

                        <!-- start DIED SLIDER layout -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.slider.Slider
                                android:id="@+id/endgame_died_slider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingStart="20dp"
                                android:stepSize="1"
                                android:value="0.0"
                                android:valueFrom="0.0"
                                android:valueTo="4.0"
                                app:labelBehavior="gone"
                                app:thumbColor="#926FDB"
                                app:tickColorActive="#c64e34"
                                app:trackColorActive="@color/customTextPrimary"
                                app:trackColorInactive="@color/customTextPrimary" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- end DIED card layout -->

            <!-- start NO SHOW card layout -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/no_show"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin"
                android:layout_marginHorizontal="@dimen/card_margin"
                app:cardBackgroundColor="#93A685"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- start NO SHOW CHIP layout -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/section_padding">

                        <TextView
                            android:id="@+id/no_show_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="NO SHOW"
                            android:textColor="@color/customTextPrimary"
                            android:textSize="@dimen/font_medium"
                            android:textStyle="bold" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/no_show_chip"
                            style="@style/CustomChipStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:text="No Show" />
                    </LinearLayout>
                    <!-- end NO SHOW layout -->
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- end NO SHOW card layout -->

            <!-- Section: COMMENTS -->
            <!-- start COMMENTS layout -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginTop="9dp"
                android:text="Comment"
                android:textColor="@color/colorOnBackground"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/endgame_comments_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/card_margin"
                android:layout_marginTop="@dimen/card_margin"
                android:textColorHint="#4B639D"
                app:boxBackgroundColor="#C9CACC"
                app:boxStrokeColor="#C9CACC"
                app:boxStrokeWidth="2dp"
                app:counterEnabled="true"
                app:counterMaxLength="200">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/endgame_comments_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foregroundTint="@color/colorOnPrimary"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:minLines="1"
                    android:shadowColor="#15247E"
                    android:textColor="@color/customTextPrimary"
                    android:textColorLink="#E9E2E2" />


                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                </FrameLayout>
            </com.google.android.material.textfield.TextInputLayout>
            <!-- end COMMENTS layout -->

            <!-- start QR Code button layout -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/endgame_generate_qr_button"
                    android:layout_width="275dp"
                    android:layout_height="275dp"
                    android:contentDescription="@string/qr_code_image"
                    android:focusable="true"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:shadowColor="@color/colorOnPrimary"
                    android:textColorHint="#3B59D7"
                    android:textColorLink="#FFFFFF"
                    app:backgroundTint="@color/colorPrimary"
                    app:icon="@drawable/qr_code_icon"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="120dp" />

            </RelativeLayout>
            <!-- end QR Code button layout -->

        </LinearLayout>
        <!-- end endgame fragment layout -->

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
