<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/scouting_scroll_bottom_nav__margin">

        <!-- start Autonomous fragment main layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section: PRELOAD -->
            <!-- start PRELOAD card layout -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin"
                android:layout_marginHorizontal="@dimen/card_margin"
                app:cardBackgroundColor="#719da9"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- start PRELOAD CHECKBOX layout -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/section_padding">

                        <TextView
                            android:id="@+id/auton_preload_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/preload_title"
                            android:textColor="@color/customTextPrimary"
                            android:textSize="@dimen/font_medium"
                            android:textStyle="bold" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/auton_preload_chip"
                            style="@style/CustomChipStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:text="@string/shot_preloaded_fuel" />
                    </LinearLayout>
                    <!-- end PRELOAD CHECKBOX layout -->

                    <!-- start PRELOAD ACCURACY layout -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#8DB0BA"
                        android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"

                        android:text="PRELOAD ACCURACY RATE:"

                        android:textColor="@color/customTextPrimary"
                        android:textSize="@dimen/font_medium"
                        android:padding="@dimen/section_padding"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_marginTop="7dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/rounded_rect"
                        android:backgroundTint="#FFFFFF"

                        >

                        <!-- start text for PRELOAD ACCURACY SLIDER layout -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:paddingStart="15dp"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal">


                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="N/A"
                                android:paddingStart="-1dp"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp"
                                />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="None"
                                android:layout_marginStart="45dp"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp"
                                />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Few"
                                android:layout_marginStart="64dp"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp"
                                />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="25%"
                                android:layout_marginStart="75dp"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp"
                                />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="69dp"
                                android:text="50%"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp"
                                />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="75%"
                                android:layout_marginStart="60dp"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp"
                                />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Most"
                                android:layout_marginStart="30dp"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp" />

                        </LinearLayout>

                        <!-- end text for PRELOAD ACCURACY SLIDER layout -->

                        <!-- start PRELOAD ACCURACY SLIDER layout -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            >

                            <com.google.android.material.slider.Slider
                                android:id="@+id/auton_preload_accuracy_slider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingStart="20dp"
                                android:stepSize="1.0"
                                android:value="0.0"
                                android:valueFrom="0.0"
                                android:valueTo="6.0"
                                app:labelBehavior="gone"
                                app:thumbColor="#6E79D5"
                                app:tickColorActive="#c64e34"
                                app:trackColorActive="@color/customTextPrimary"
                                app:trackColorInactive="@color/customTextPrimary" />

                        </LinearLayout>

                    </LinearLayout>
                    <!-- end PRELOAD ACCURACY layout -->
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- end PRELOAD card layout -->

            <!-- Section: HOPPER -->

            <!-- start HOPPER card layout -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginTop="@dimen/card_margin"
                android:layout_marginHorizontal="@dimen/card_margin"
                app:cardBackgroundColor="#f0a576"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- start HOPPER +/- BUTTONS layout -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="#ee965f"
                        android:padding="@dimen/section_padding">

                        <TextView
                            android:id="@+id/auton_hopper_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/hoppers_shot"
                            android:textColor="@color/customTextPrimary"
                            android:textSize="@dimen/font_medium"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/auton_hopper_decr_button"
                            android:layout_width="80dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="70dp"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:backgroundTint="#c64e34"
                            android:text="@string/decrease"
                            android:textAlignment="center"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/font_medium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/auton_hopper_total_text"
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:text="@string/hopper_count_total"
                            android:textColor="@color/customTextPrimary"
                            android:textSize="@dimen/font_large" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/auton_hopper_incr_button"
                            android:layout_width="80dp"
                            android:layout_height="40dp"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:backgroundTint="#c64e34"
                            android:text="@string/increase"
                            android:textAlignment="center"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/font_medium"
                            android:textStyle="bold" />

                    </LinearLayout>
                    <!-- end HOPPER +/- BUTTONS layout -->

                    <!-- start HOPPER ACCURACY layout -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="4dp"
                        android:text="ACCURACY RATE:"
                        android:backgroundTint="#ee8a5f"
                        android:background="@drawable/rounded_rect"
                        android:textColor="@color/customTextPrimary"
                        android:textSize="@dimen/font_medium"
                        android:padding="@dimen/section_padding"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="575dp"
                        android:layout_marginTop="7dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/rounded_rect"
                        android:backgroundTint="#FFFFFF"
                        android:layout_marginStart="9dp"
                        >

                        <!-- start text for HOPPER ACCURACY SLIDER layout -->
                        <LinearLayout
                            android:layout_width="580dp"
                            android:layout_height="30dp"
                            android:paddingStart="15dp"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="N/A"
                                android:paddingStart="-1dp"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp"
                                />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="None"
                                android:layout_marginStart="36dp"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp"
                                />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Few"
                                android:layout_marginStart="51dp"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp"
                                />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="25%"
                                android:layout_marginStart="58dp"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp"
                                />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="57dp"
                                android:text="50%"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp"
                                />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="75%"
                                android:layout_marginStart="55dp"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp"
                                />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Most"
                                android:layout_marginStart="36dp"
                                android:textColor="@color/customTextPrimary"
                                android:textSize="19sp"
                                />

                        </LinearLayout>

                        <!-- end text for HOPPER ACCURACY SLIDER layout -->

                        <!-- start HOPPER ACCURACY SLIDER layout -->
                        <LinearLayout
                            android:layout_width="580dp"
                            android:layout_height="wrap_content"
                            >

                            <com.google.android.material.slider.Slider
                                android:id="@+id/auton_hopper_accuracy_slider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingStart="20dp"
                                android:stepSize="1.0"
                                android:value="0.0"
                                android:valueFrom="0.0"
                                android:valueTo="6.0"
                                app:trackColorActive="@color/customTextPrimary"
                                app:trackColorInactive="@color/customTextPrimary"
                                app:thumbColor="#c64e34"
                                app:tickColorActive="#c64e34"
                                app:labelBehavior="gone" />

                        </LinearLayout>
                        <!-- end HOPPER ACCURACY SLIDER layout -->
                    </LinearLayout>



                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- end HOPPER card layout -->

            <!-- Section: FUEL -->
            <!-- start FUEL card layout -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin"
                android:layout_marginHorizontal="@dimen/card_margin"
                app:cardBackgroundColor="#D48C74"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/section_padding">

                    <TextView
                        android:id="@+id/auton_fuel_source_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/fuel_source"
                        android:textColor="@color/customTextPrimary"
                        android:textSize="@dimen/font_medium"
                        android:textStyle="bold" />

                    <!-- start FUEL CHIPS layout -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/auton_az_chip"
                        style="@style/CustomChipStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/alliance_zone" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/auton_depot_chip"
                        style="@style/CustomChipStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="@string/depot" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/auton_outpost_chip"
                        style="@style/CustomChipStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="@string/outpost" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/auton_nz_chip"
                        style="@style/CustomChipStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="@string/neutral_zone" />

                    <!-- end FUEL CHIPS layout -->
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- end FUEL card layout -->

            <!-- Section: CLIMB -->
            <!-- start CLIMB card layout -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/auton_climb_position"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin"
                android:layout_marginHorizontal="@dimen/card_margin"
                app:cardBackgroundColor="#93A685"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- start AUTON CLIMB CHIP layout -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/section_padding">

                        <TextView
                            android:id="@+id/auton_climb_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/auton_climb_title"
                            android:textColor="@color/customTextPrimary"
                            android:textSize="@dimen/font_medium"
                            android:textStyle="bold" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/auton_climb_chip"
                            style="@style/CustomChipStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:text="@string/auton_climb_chip" />
                    </LinearLayout>

                    <!-- end AUTON CLIMB CHIP layout -->
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- end CLIMB card layout -->

        </LinearLayout>
        <!-- end Autonomous fragment main layout -->

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
